# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public site URL where GameZone PK is hosted.
APP_URL="https://gamezone-pk-talha-talha-5fd4.vercel.app"

# PostgreSQL Database Runtime & Admin Credentials (Object Method)
SQL_HOST="YOUR_SQL_HOST"
SQL_DB_NAME="YOUR_SQL_DB_NAME"
SQL_USER="YOUR_SQL_USER"
SQL_PASSWORD="YOUR_SQL_PASSWORD"
SQL_ADMIN_USER="YOUR_SQL_ADMIN_USER"
SQL_ADMIN_PASSWORD="YOUR_SQL_ADMIN_PASSWORD"

# Supabase Compatibility Placeholders (for external Vercel/Supabase deployment reference)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_PUBLIC_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY_SERVER_ONLY"

# Official Easypaisa Merchant Gateway Credentials (Server-Side Only)
# Portal: https://merchantportal.easypaisa.com.pk/
EASYPAISA_STORE_ID="YOUR_EASYPAISA_STORE_ID"
EASYPAISA_HASH_KEY="YOUR_EASYPAISA_MERCHANT_HASH_KEY"
EASYPAISA_POSTBACK_URL="https://gamezone-pk-talha-talha-5fd4.vercel.app/api/easypaisa/callback"
EASYPAISA_ENV="sandbox"

# Optional Server-Side Email Notification Provider
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
